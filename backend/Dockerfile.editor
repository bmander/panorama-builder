# syntax=docker/dockerfile:1

# Editor image: cgo + Ceres-Solver via libceres-dev. Larger image (~200 MB)
# than the reader, slower cold start. Use for the edit.photos.bmander.com
# Cloud Run service (min-instances=0; user accepts the wake-up cost when
# clicking Edit).
#
# Build context is backend/. The frontend's static files are mounted at
# runtime via STATIC_DIR when relevant.

FROM golang:1.25-bookworm AS build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends \
      libceres-dev \
      libeigen3-dev \
      libsuitesparse-dev \
      libgoogle-glog-dev \
      libgflags-dev \
      pkg-config \
      build-essential \
  && rm -rf /var/lib/apt/lists/*
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -o /out/panorama-editor .

FROM debian:bookworm-slim
# libceres2 pulls in its full runtime dependency closure (SuiteSparse,
# BLAS/LAPACK, glog, gflags). ca-certificates is needed for HTTPS to GCS.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libceres3 \
      ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/panorama-editor /panorama-editor
EXPOSE 8080
ENV LISTEN_ADDR=:8080
ENTRYPOINT ["/panorama-editor"]
