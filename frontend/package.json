{
  "name": "panorama-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:docker-split": "VITE_READ_API_BASE=http://localhost:8080/api VITE_WRITE_API_BASE=http://localhost:8081/api vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "generate-types": "openapi-typescript ../openapi.yaml -o src/api-types.gen.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.0",
    "@types/three": "^0.184.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "three": "^0.184.0"
  }
}
